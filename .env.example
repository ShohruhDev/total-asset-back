# =====================================================
# Total Asset Silk Road — Backend (Directus 11 + Postgres)
# Local dev via docker compose. Production via Railway.
# =====================================================

# ---- Database (used by docker-compose + Directus) ----
DB_USER=directus
DB_PASSWORD=directus
DB_DATABASE=directus

# ---- Directus core ----
# Generate KEY/SECRET ONCE — never rotate (breaks sessions).
#   openssl rand -hex 16   →  DIRECTUS_KEY
#   openssl rand -hex 32   →  DIRECTUS_SECRET
DIRECTUS_KEY=replace-me-with-a-random-uuid-key
DIRECTUS_SECRET=replace-me-with-a-random-secret
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ---- First-boot admin (REMOVE from prod env after rotating password in UI) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# ---- Email ----
# In production use SMTP (Resend / Postmark / SES / client SMTP)
EMAIL_FROM=noreply@total-asset.uz
# Production overrides (uncomment + fill):
# EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=smtp.resend.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=resend
# EMAIL_SMTP_PASSWORD=re_xxx_xxx

# =====================================================
# Cloudflare R2 (production media storage) — uncomment in prod
# =====================================================
# STORAGE_LOCATIONS=r2
# STORAGE_R2_DRIVER=s3
# STORAGE_R2_KEY=
# STORAGE_R2_SECRET=
# STORAGE_R2_BUCKET=total-asset-media
# STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_R2_REGION=auto
# STORAGE_R2_FORCE_PATH_STYLE=true
# STORAGE_R2_ACL=
